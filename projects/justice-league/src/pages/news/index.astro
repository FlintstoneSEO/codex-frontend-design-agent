---
import Breadcrumbs from "@/components/Breadcrumbs.astro";
import ElinkNews from "@/components/ElinkNews.astro";
import NewsletterShell from "@/components/NewsletterShell.astro";
import PageIntro from "@/components/PageIntro.astro";
import { currentWixRoutes } from "@/data/site";
import BaseLayout from "@/layouts/BaseLayout.astro";
---

<BaseLayout pageType="WebPage" title="News, Videos, and E-News | Justice League GLM" description="Follow Justice League GLM media coverage, recent videos, the guarded eLink news collection, and the current E-News Brief archive.">
  <main id="main-content" class="interior-page" tabindex="-1">
    <Breadcrumbs items={[{ label: "Home", href: "/" }, { label: "News and stories" }]} />
    <PageIntro kicker="Community record" title="News, Videos, and E-News" lede="Current coverage is distributed across an eLink collection, the Wix media page, and the E-News Brief archive." mode="documentary" marker="Dated context" />

    <section class="documentary-record" aria-labelledby="latest-news-heading">
      <div><p class="section-kicker">Latest news</p><h2 id="latest-news-heading">Open the current editorial collection deliberately.</h2><p>eLink does not provide an RSS feed for this collection. The third-party embed remains consent-gated, with a direct source link available when scripts are blocked or declined.</p><ElinkNews /></div>
    </section>

    <section class="story-review" aria-labelledby="video-treatment"><div class="section-heading-row"><p class="section-kicker">Recent video features</p><h2 id="video-treatment">Stories published through the current media page.</h2></div><article class="story-row"><div class="story-index">Video / 01</div><div><h3>The Story Behind the Justice League of Greater Lansing</h3><p>The current Wix page presents an organization overview focused on reparations, community, and justice.</p><a class="text-action" href={currentWixRoutes.news} target="_blank" rel="noreferrer">Watch on the current site <span class="visually-hidden">(opens in a new tab)</span></a></div></article><article class="story-row"><div class="story-index">Video / 02</div><div><h3>MSU Broad Art Museum: Reparations Reframed</h3><p>The current media page also features the Justice League's collaboration with the MSU Broad Art Museum.</p><a class="text-action" href={currentWixRoutes.news} target="_blank" rel="noreferrer">Watch on the current site <span class="visually-hidden">(opens in a new tab)</span></a></div></article></section>

    <section class="evidence-note" aria-labelledby="enews-heading"><p class="section-kicker">E-News Briefs</p><h2 id="enews-heading">The current archive page does not expose entries.</h2><p>Its public table currently shows only the Date, Subject, and View More headings. No newsletter issue is invented or migrated without a visible source record.</p><a class="text-action" href={currentWixRoutes.newsletterArchive} target="_blank" rel="noreferrer">Check the current E-News archive <span class="visually-hidden">(opens in a new tab)</span></a></section>
    <NewsletterShell />
  </main>
</BaseLayout>
