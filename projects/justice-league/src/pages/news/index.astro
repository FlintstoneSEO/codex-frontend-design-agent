---
import Breadcrumbs from "@/components/Breadcrumbs.astro";
import ElinkNews from "@/components/ElinkNews.astro";
import NewsletterShell from "@/components/NewsletterShell.astro";
import PageIntro from "@/components/PageIntro.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import pageMeta from "@/content/pages/news.json";
---

<BaseLayout pageType="WebPage" title={pageMeta.seo_title} description="Read the latest Justice League GLM coverage, explore community stories, and find videos and newsletter updates.">
  <main id="main-content" class="interior-page" tabindex="-1">
    <Breadcrumbs items={[{ label: "Home", href: "/" }, { label: "News & stories" }]} />
    <PageIntro kicker="Justice League in the community" title="News & Stories" lede="Follow community coverage, initiatives, and conversations connected to the Justice League’s work in Greater Lansing." mode="evidence" marker="Latest coverage" />
    <section class="documentary-record" aria-labelledby="latest-news-heading"><div><p class="section-kicker">Latest news</p><h2 id="latest-news-heading">Read recent coverage and community stories.</h2><p>Explore the Justice League’s current editorial collection for news, updates, and stories from the community.</p><ElinkNews /></div></section>
    <section class="evidence-note" aria-labelledby="media-heading"><p class="section-kicker">Photos & videos</p><h2 id="media-heading">See the work in motion.</h2><p>Watch Justice League videos and explore documentary photography from community events, reparations conversations, and scholarship celebrations.</p><a class="button button-secondary" href="/media/">Explore photos & videos</a></section>
    <section class="evidence-note" aria-labelledby="enews-heading"><p class="section-kicker">E-News</p><h2 id="enews-heading">Get Justice League updates by email.</h2><p>Subscribe below to stay connected with news, events, and opportunities to participate.</p></section>
    <NewsletterShell />
  </main>
</BaseLayout>
