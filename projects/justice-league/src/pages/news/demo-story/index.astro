---
import ActionBand from "@/components/ActionBand.astro";
import Breadcrumbs from "@/components/Breadcrumbs.astro";
import { demoStory } from "@/data/content";
import BaseLayout from "@/layouts/BaseLayout.astro";
---

<BaseLayout title="Demonstration Story | Justice League GLM Prototype" description="A noindex demonstration of the editorial, sourcing, and correction structure required for future Justice League GLM stories.">
  <main id="main-content" class="interior-page">
    <Breadcrumbs items={[{ label: "Home", href: "/" }, { label: "News and stories", href: "/news/" }, { label: "Demonstration story" }]} />
    <article class="article-page">
      <header class="article-header"><p class="placeholder-label">Demonstration fixture—not published reporting</p><h1>{demoStory.title}</h1><p class="page-lede">{demoStory.excerpt}</p><dl><div><dt>Publisher</dt><dd>[NEEDS CLIENT INPUT]</dd></div><div><dt>Published</dt><dd>[NEEDS CLIENT INPUT]</dd></div><div><dt>Last corrected</dt><dd>[NEEDS CLIENT INPUT]</dd></div></dl></header>
      <div class="article-body"><p class="section-kicker">Structural placeholder</p>{demoStory.body.map((paragraph) => <p>{paragraph}</p>)}<h2>Context and continuation</h2><p>[PLACEHOLDER: A verified sub-section would connect the specific account to related history, evidence, or action without repeating unrelated campaign copy.]</p></div>
      <footer class="article-sources"><h2>Sources and corrections</h2><ul>{demoStory.sourceNotes.map((note) => <li>{note}</li>)}</ul><p>Future corrections will retain the original publication date and add a clear update note.</p></footer>
    </article>
    <ActionBand kicker="Related context" title="Continue with an evergreen explanation." text="This fixture carries no event, impact, or community claim." primaryLabel="Reparations in Greater Lansing" primaryHref="/reparations/" secondaryLabel="Back to news" secondaryHref="/news/" />
  </main>
</BaseLayout>
