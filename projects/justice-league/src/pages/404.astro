---
import BaseLayout from "@/layouts/BaseLayout.astro";
---

<BaseLayout pageType="WebPage" title="Page Not Found | Justice League GLM" description="The requested Justice League GLM page could not be found.">
  <main id="main-content" class="interior-page" tabindex="-1">
    <section class="page-intro page-intro--evidence" aria-labelledby="not-found-heading">
      <div class="page-intro-copy">
        <p class="section-kicker">404 · Page not found</p>
        <h1 id="not-found-heading">This public record has moved or is unavailable.</h1>
        <p>Use a current destination below. If a legacy Justice League link brought you here, please report it so the route can be reconciled.</p>
        <div class="hero-actions">
          <a class="button button-primary" href="/">Return home</a>
          <a class="button button-secondary" href="/contact/">Report a broken link</a>
        </div>
      </div>
    </section>
  </main>
</BaseLayout>
