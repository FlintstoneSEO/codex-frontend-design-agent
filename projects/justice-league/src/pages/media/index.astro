---
import Breadcrumbs from "@/components/Breadcrumbs.astro";
import MediaGallery from "@/components/MediaGallery.astro";
import PageIntro from "@/components/PageIntro.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
---

<BaseLayout pageType="WebPage" title="Photos & Videos | Justice League GLM" description="Explore Justice League GLM documentary photography and videos from Lansing community events, reparations work, and scholarship celebrations.">
  <main id="main-content" class="interior-page" tabindex="-1">
    <Breadcrumbs items={[{ label: "Home", href: "/" }, { label: "Photos & videos" }]} />
    <PageIntro kicker="Media" title="Photos & Videos" lede="Explore moments, conversations, and celebrations from the Justice League’s work in Greater Lansing." mode="documentary" marker="In the community" />
    <MediaGallery />
  </main>
</BaseLayout>
