---
import ActionBand from "@/components/ActionBand.astro";
import Breadcrumbs from "@/components/Breadcrumbs.astro";
import PageIntro from "@/components/PageIntro.astro";
import { supportHandoffs } from "@/data/content";
import { currentWixRoutes, site } from "@/data/site";
import BaseLayout from "@/layouts/BaseLayout.astro";
import pageMeta from "@/content/pages/support-reparations.json";
---

<BaseLayout pageType="WebPage" title={pageMeta.seo_title} description={pageMeta.meta_description}>
  <main id="main-content" class="interior-page" tabindex="-1">
    <Breadcrumbs items={[{ label: "Home", href: "/" }, { label: "Donate" }]} />
    <PageIntro kicker="Support the work" title="Donate to Justice League GLM" lede="Choose whether your gift supports reparations initiatives or the administration needed to carry them out." mode="campaign" marker="Give with purpose">
      <span slot="kicker" data-editable="source" data-path="/src/pages/support-reparations/index.astro" data-key="support-intro-kicker">Primary sitewide action</span>
      <span slot="title" data-editable="source" data-path="/src/pages/support-reparations/index.astro" data-key="support-intro-title">Support Reparations</span>
      <span slot="lede" data-editable="source" data-path="/src/pages/support-reparations/index.astro" data-key="support-intro-lede">Choose whether your contribution supports reparations initiatives or the administration needed to carry them out.</span>
      <span slot="marker" data-editable="source" data-path="/src/pages/support-reparations/index.astro" data-key="support-intro-marker">Choose / support</span>
    </PageIntro>
    <section class="designation-section" aria-labelledby="designation-heading"><div class="section-heading-row"><p class="section-kicker">Choose your support</p><h2 id="designation-heading">Your contribution helps make repair possible.</h2></div><ol>{supportHandoffs.map((item, index) => <li><span>{String(index + 1).padStart(2, "0")}</span><div><h3>{item.label}</h3><p>{item.description}</p></div></li>)}</ol></section>
    <section class="unavailable-action" aria-labelledby="support-handoff"><p class="section-kicker">Secure online donation</p><h2 id="support-handoff">Give online through PayPal.</h2><p>Use the Justice League’s approved PayPal donation page to securely select your gift and donation designation.</p><a class="button button-primary button-accent" href={currentWixRoutes.paypalDonate} target="_blank" rel="noreferrer">Donate with PayPal <span class="visually-hidden">(opens in a new tab)</span></a></section>
    <section class="withheld-section" aria-labelledby="mail-support"><p class="section-kicker">Mail a reparations payment or donation</p><h2 id="mail-support">Send the support card with your check.</h2><p>Make checks payable to “{site.name}” and mail them to {site.mailingAddress.line1}, {site.mailingAddress.line2}.</p><a class="text-action" href={currentWixRoutes.supportCard} target="_blank" rel="noreferrer">Download the current support card <span class="visually-hidden">(opens in a new tab)</span></a><p class="source-line">The current Wix page does not publish recurring-gift, fee, refund, or tax-deductibility terms; those claims are not added here.</p></section>
    <ActionBand kicker="Non-financial pathway" title="Participation does not require a payment." text="Attend a meeting, contribute time, request a presentation, or begin a partnership conversation." primaryLabel="Join the Work" primaryHref="/join-the-work/" secondaryLabel="Understand reparations" secondaryHref="/reparations/" />
  </main>
</BaseLayout>
