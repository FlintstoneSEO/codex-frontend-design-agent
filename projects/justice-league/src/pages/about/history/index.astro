---
import ActionBand from "@/components/ActionBand.astro";
import Breadcrumbs from "@/components/Breadcrumbs.astro";
import PageIntro from "@/components/PageIntro.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import pageMeta from "@/content/pages/history.json";
import { timelineMilestones } from "@/data/timeline";

const timelineUrl = "https://www.justiceleagueglm.org/timeline";
const historyUrl = "https://www.justiceleagueglm.org/history";
---

<BaseLayout pageType="WebPage" title={pageMeta.seo_title} description={pageMeta.meta_description}>
  <main id="main-content" class="interior-page" tabindex="-1">
    <Breadcrumbs items={[{ label: "Home", href: "/" }, { label: "About", href: "/about/" }, { label: "History" }]} />
    <PageIntro kicker="Greater Lansing public record" title="History and Timeline" lede="From a faith-rooted call to repair toward scholarships, homeownership, public education, and regional collaboration." mode="evidence" marker="2021–2026">
      <span slot="kicker" data-editable="source" data-path="/src/pages/about/history/index.astro" data-key="history-intro-kicker">Greater Lansing public record</span>
      <span slot="title" data-editable="source" data-path="/src/pages/about/history/index.astro" data-key="history-intro-title">History and Timeline</span>
      <span slot="lede" data-editable="source" data-path="/src/pages/about/history/index.astro" data-key="history-intro-lede">From a faith-rooted call to repair toward scholarships, homeownership, public education, and regional collaboration.</span>
      <span slot="marker" data-editable="source" data-path="/src/pages/about/history/index.astro" data-key="history-intro-marker">2021–2026</span>
    </PageIntro>

    <aside class="source-notice" aria-label="Content review status"><strong>Approved current-site record</strong><p>Timeline content and imagery were reconciled against the live Wix page on August 9, 2026. <a href={timelineUrl} target="_blank" rel="noreferrer">Review the live timeline <span class="visually-hidden">(opens in a new tab)</span></a>.</p></aside>

    <section class="history-context" aria-labelledby="history-context-heading">
      <div><p class="section-kicker">Why this history matters</p><h2 id="history-context-heading">Repair responds to structural harm.</h2></div>
      <div class="history-context-copy">
        <p>The current history page connects the racial wealth divide to slavery and its aftermath, including sharecropping, Jim Crow, redlining, unequal access to public benefits, and continuing structural racism.</p>
        <p>It argues that structural problems require structural responses and calls faith communities to take a practical first step in acknowledgment, redress, relationship, and repair.</p>
        <ol class="history-pillars" aria-label="The organization’s three reparations pillars"><li><span>01</span><strong>Educational scholarships</strong></li><li><span>02</span><strong>Homeownership</strong></li><li><span>03</span><strong>Business entrepreneurship</strong></li></ol>
        <p class="source-line"><a href={historyUrl} target="_blank" rel="noreferrer">Read the current Wix history context <span class="visually-hidden">(opens in a new tab)</span></a>.</p>
      </div>
    </section>

    <section class="timeline-section" aria-labelledby="timeline-heading">
      <div class="section-heading-row"><p class="section-kicker">Reconciled chronology</p><h2 id="timeline-heading">From formation to visible local repair.</h2></div>
      <ol class="timeline-list">
        {timelineMilestones.map((milestone) => (
          <li>
            <div class="timeline-date"><time datetime={milestone.datetime}>{milestone.date}</time><span>Current-site record</span></div>
            <article class="timeline-entry-content" id={milestone.id}>
              <h3>{milestone.title}</h3>
              <div class="timeline-entry-copy">{milestone.paragraphs.map((paragraph) => <p>{paragraph}</p>)}</div>
              {milestone.images && <div class:list={["timeline-media-group", { "timeline-media-group--multiple": milestone.images.length > 1 }]}>
                {milestone.images.map((image) => <figure class:list={["timeline-media", `timeline-media--${image.kind ?? "photo"}`]}>
                  <img src={image.src} width={image.width} height={image.height} alt={image.alt} loading="lazy" decoding="async" />
                  <figcaption>{image.caption} Image reused from the approved current Wix timeline.</figcaption>
                </figure>)}
              </div>}
              {milestone.links && <p class="source-line">{milestone.links.map((link, index) => <>{index > 0 && " · "}<a href={link.href} target="_blank" rel="noreferrer">{link.label} <span class="visually-hidden">(opens in a new tab)</span></a></>)}</p>}
              <p class="source-line"><a href={timelineUrl} target="_blank" rel="noreferrer">View this milestone in the full current timeline <span class="visually-hidden">(opens in a new tab)</span></a></p>
            </article>
          </li>
        ))}
      </ol>
    </section>

    <section class="evidence-note" aria-labelledby="history-standard"><p class="section-kicker">Publication standard</p><h2 id="history-standard">Keep the record accountable.</h2><ul><li>New milestones need a date, approved narrative, and public source.</li><li>Photographs need confirmed reuse permission, useful alt text, and a caption.</li><li>Financial or program claims need an owner and a scheduled review date.</li><li>Corrections should identify what changed and when.</li></ul><p>[NEEDS CLIENT INPUT: Confirm who owns ongoing history corrections and milestone approval after launch.]</p></section>
    <ActionBand kicker="Continue the record" title="Understand the method, then choose a role." text="Explore how the Justice League frames reparations in Greater Lansing or find a participation path that fits." primaryLabel="Explore reparations" primaryHref="/reparations/" secondaryLabel="Join the work" secondaryHref="/join-the-work/" />
  </main>
</BaseLayout>
