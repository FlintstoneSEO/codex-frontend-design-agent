---
import ActionBand from "@/components/ActionBand.astro";
import Breadcrumbs from "@/components/Breadcrumbs.astro";
import PageIntro from "@/components/PageIntro.astro";
import SourceNotice from "@/components/SourceNotice.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
const methods = ["Education", "Relationship building", "Scholarships", "Economic repair", "Collective action"];
---

<BaseLayout pageType="WebPage" title="Reparations in Greater Lansing | Justice League GLM" description="Explore the Justice League's provisional framework for education, relationship building, scholarships, economic repair, and collective action.">
  <main id="main-content" class="interior-page">
    <Breadcrumbs items={[{ label: "Home", href: "/" }, { label: "Reparations" }]} />
    <PageIntro kicker="Local education" title="Reparations in Greater Lansing" lede="Understanding comes before action. This prototype separates the local framework from claims that still need sources and approval." mode="evidence" marker="Learn / act" />
    <SourceNotice />
    <section class="definition-block" aria-labelledby="definition-heading"><p class="section-kicker">Definition gate</p><h2 id="definition-heading">Start with an approved, plain-language definition.</h2><p class="placeholder-statement">[NEEDS CLIENT INPUT: Approve the organization's definition of reparations and the sources that support it.]</p><p>The prototype does not substitute a generic definition or an unsourced statistic for the organization's own accountable explanation.</p></section>
    <section class="editorial-split" aria-labelledby="local-heading"><div class="section-index">01 / Local</div><div><h2 id="local-heading">A Greater Lansing framework.</h2><p>The current site describes a faith-rooted, community-centered approach that connects racial justice, relationship building, scholarship, and wealth equity. The exact service area, participating relationships, and public claims require confirmation.</p><a class="text-action" href="/about/history/">Review the developing history</a></div></section>
    <section class="ruled-section" aria-labelledby="methods-heading"><div class="section-heading-row"><p class="section-kicker">Provisional method pathway</p><h2 id="methods-heading">Five ways the current site describes the work.</h2></div><ol class="method-rail">{methods.map((method, index) => <li><span>{String(index + 1).padStart(2, "0")}</span><strong>{method}</strong><p>[NEEDS CLIENT INPUT: Approve this method and add a source, example, limitation, and related action.]</p></li>)}</ol></section>
    <section class="evidence-note" aria-labelledby="source-standard"><p class="section-kicker">Evidence standard</p><h2 id="source-standard">Claims need dates, methods, and limits.</h2><p>Future evidence should name its reporting period, source, methodology, content owner, approval status, and known limitations. The accountability page demonstrates that record.</p><a class="text-action" href="/impact/">Review impact and accountability</a></section>
    <ActionBand kicker="Primary action" title="Support the work after understanding it." text="The support page explains the two provisional contribution designations before any future payment handoff." primaryLabel="Support Reparations" primaryHref="/support-reparations/" secondaryLabel="Join the Work" secondaryHref="/join-the-work/" />
  </main>
</BaseLayout>
