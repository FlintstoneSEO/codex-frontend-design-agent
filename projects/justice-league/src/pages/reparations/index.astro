---
import ActionBand from "@/components/ActionBand.astro";
import Breadcrumbs from "@/components/Breadcrumbs.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import page from "@/content/pages/reparations.json";

const model = [
  { label: "Partners commit", text: "Predominantly white houses of worship, individuals, organizations, and community partners make reparations contributions and build accountable relationships." },
  { label: "Resources are gathered", text: "Contributions build a locally focused reparations and endowment fund rather than a short-term charitable campaign." },
  { label: "Community guides", text: "African American community representation and advisory leadership guide how reparations resources are distributed." },
  { label: "Opportunity grows", text: "Resources support direct pathways to education, homeownership, and business development in Greater Lansing." }
] as const;

const pathways = [
  { number: "01", title: "Education", text: "Reparations Scholarships expand access to college, university, vocational, and other educational opportunities for eligible African American students in the Greater Lansing area.", link: "/scholarship/", label: "Explore Reparations Scholarships" },
  { number: "02", title: "Homeownership", text: "Reparations resources are intended to confront the legacy of housing discrimination by supporting pathways to homeownership and the intergenerational wealth an owned home can help build. The Justice League timeline documents reparations-supported home construction with a local partner; current application terms are not publicly available.", link: "/about/history/", label: "See housing milestones" },
  { number: "03", title: "Business development", text: "The adopted business-development pillar seeks to help African American entrepreneurs establish or grow businesses—another route to asset ownership and lasting wealth. Public grant amounts, eligibility rules, deadlines, and current application availability have not been announced.", link: "/join-the-work/", label: "Ask about partnership" }
] as const;
---

<BaseLayout pageType="WebPage" title={page.seo_title} description={page.meta_description} noindex={false}>
  <main id="main-content" class="interior-page reparations-page" tabindex="-1">
    <Breadcrumbs items={[{ label: "Home", href: "/" }, { label: "Reparations" }]} />

    <header class="reparations-hero">
      <div class="reparations-hero__copy">
        <p class="section-kicker">{page.hero.eyebrow}</p>
        <h1>{page.hero.heading}</h1>
        <p class="reparations-hero__lede">{page.hero.description}</p>
        <div class="reparations-hero__actions">
          <a class="button button-primary" href={page.hero.primary_cta_url}>{page.hero.primary_cta_text}</a>
          <a class="button button-secondary" href={page.hero.secondary_cta_url}>{page.hero.secondary_cta_text}</a>
        </div>
      </div>
      <div class="reparations-hero__statement" aria-hidden="true"><span>Faith</span><span>Relationship</span><span>Repair</span></div>
    </header>

    <section id="our-approach" class="reparations-definition" aria-labelledby="definition-heading">
      <div>
        <p class="section-kicker">{page.definition.eyebrow}</p>
        <h2 id="definition-heading">{page.definition.heading}</h2>
      </div>
      <div class="reparations-definition__copy">
        {page.definition.body.map((paragraph) => <p>{paragraph}</p>)}
        <blockquote><p>{page.definition.callout}</p></blockquote>
      </div>
    </section>

    <section class="reparations-history" aria-labelledby="history-heading">
      <div class="reparations-section-heading"><p class="section-kicker">Why repair is necessary</p><h2 id="history-heading">{page.history_heading}</h2><p>{page.history_intro}</p></div>
      <ol class="reparations-history__list">{page.history_records.map((item, index) => <li><span>{String(index + 1).padStart(2, "0")}</span><div><p class="reparations-history__period">{item.period}</p><h3>{item.heading}</h3><p>{item.summary}</p><details><summary>Read the historical context</summary><p>{item.detail}</p></details></div></li>)}</ol>
      <a class="text-action" href="/about/history/">Explore the Justice League history and milestones</a>
    </section>

    <section class="reparations-model" aria-labelledby="model-heading">
      <div class="reparations-section-heading"><p class="section-kicker">How the model works</p><h2 id="model-heading">{page.model_heading}</h2><p>Participation moves through a clear, community-accountable sequence. The fund is a means—not the endpoint. Its purpose is to create durable wealth-building opportunity.</p></div>
      <ol class="reparations-model__flow">{model.map((step, index) => <li><span class="reparations-model__number">{String(index + 1).padStart(2, "0")}</span><div><h3>{step.label}</h3><p>{step.text}</p></div></li>)}</ol>
      <p class="reparations-model__note"><strong>Governance matters:</strong> African American community guidance helps keep local reparations accountable to the people and priorities the work is intended to serve. <a href="/about/leadership/">Learn about leadership</a>.</p>
    </section>

    <section class="reparations-pathways" aria-labelledby="pathways-heading">
      <div class="reparations-section-heading"><p class="section-kicker">Three pathways to repair</p><h2 id="pathways-heading">{page.pathways_heading}</h2><p>Each pathway addresses a place where historic exclusion has constrained access to assets, opportunity, and intergenerational wealth.</p></div>
      <ol>{pathways.map((pathway) => <li><span class="reparations-pathways__number">{pathway.number}</span><div><h3>{pathway.title}</h3><p>{pathway.text}</p><a class="text-action" href={pathway.link}>{pathway.label}</a></div></li>)}</ol>
    </section>

    <section class="reparations-faith" aria-labelledby="faith-heading">
      <p class="section-kicker">Faith into action</p><h2 id="faith-heading">{page.faith_heading}</h2>
      <div><p>The Justice League asks faith communities to do more than acknowledge historical racial injustice. Repentance calls for changed relationships and material participation in repair.</p><p>Through sustained relationship, reparative contribution, and accountability, houses of worship and partners can help move Greater Lansing toward the Beloved Community—and become “repairers of the breach.”</p></div>
      <figure class="reparations-faith__media">
        <img src="https://static.wixstatic.com/media/de1bf2_3db3fad3b2d4409f94a145ec04ddb86f~mv2.jpg/v1/fill/w_900,h_598,al_c,q_82,enc_avif,quality_auto/de1bf2_3db3fad3b2d4409f94a145ec04ddb86f~mv2.jpg" width="900" height="598" alt="Participants gathered for the January 2023 apology and reparations event at Lansing Reachout Christian Center" loading="lazy" decoding="async" />
        <figcaption>The January 2023 Lansing Reachout gathering joined a public liturgy of repentance with a call for structural action. Photograph reused from the Justice League’s current Wix timeline.</figcaption>
      </figure>
    </section>

    <section class="reparations-action-record" aria-labelledby="action-record-heading">
      <div><p class="section-kicker">Reparations in action</p><h2 id="action-record-heading">Follow the documented work.</h2></div>
      <nav aria-label="Reparations evidence and updates"><a href="/about/"><strong>About</strong><span>Mission, vision, and the organization behind the model</span></a><a href="/about/history/"><strong>History</strong><span>Dated scholarship, housing, congregational, and fund milestones</span></a><a href="/scholarship/"><strong>Scholarship</strong><span>Program information and published recipient records</span></a><a href="/impact/"><strong>Impact</strong><span>Evidence, accountability, supporters, and donor records</span></a></nav>
    </section>

    <ActionBand kicker={page.action.eyebrow} title={page.action.heading} text={page.action.description} primaryLabel={page.action.primary_cta_text} primaryHref={page.action.primary_cta_url} secondaryLabel={page.action.secondary_cta_text} secondaryHref={page.action.secondary_cta_url} />
  </main>
</BaseLayout>
