---
import ActionBand from "@/components/ActionBand.astro";
import Breadcrumbs from "@/components/Breadcrumbs.astro";
import PageIntro from "@/components/PageIntro.astro";
import { supporters } from "@/data/supporters";
import BaseLayout from "@/layouts/BaseLayout.astro";
import pageMeta from "@/content/pages/supporters.json";
---

<BaseLayout
  pageType="WebPage"
  title={pageMeta.seo_title}
  description={pageMeta.meta_description}
>
  <main id="main-content" class="interior-page supporters-page" tabindex="-1">
    <Breadcrumbs items={[{ label: "Home", href: "/" }, { label: "Supporters" }]} />
    <PageIntro
      kicker="Justice League GLM supporters"
      title="Repairers of the Breach"
      lede="The Justice League recognizes these houses of worship, foundations, and community organizations as current supporters. This curated roster is separate from the year-based donor acknowledgment."
      mode="documentary"
      marker="In community"
    >
      <span slot="kicker" data-editable="source" data-path="/src/pages/supporters/index.astro" data-key="supporters-intro-kicker">Justice League GLM supporters</span>
      <span slot="title" data-editable="source" data-path="/src/pages/supporters/index.astro" data-key="supporters-intro-title">Repairers of the Breach</span>
      <span slot="lede" data-editable="source" data-path="/src/pages/supporters/index.astro" data-key="supporters-intro-lede">The Justice League recognizes these houses of worship, foundations, and community organizations as current supporters. This curated roster is separate from the year-based donor acknowledgment.</span>
      <span slot="marker" data-editable="source" data-path="/src/pages/supporters/index.astro" data-key="supporters-intro-marker">In community</span>
    </PageIntro>

    <section class="supporter-roster" aria-labelledby="supporter-roster-heading">
      <header data-editable="source" data-path="/src/pages/supporters/index.astro" data-key="supporters-roster-intro">
        <p class="section-kicker">Current Wix roster</p>
        <h2 id="supporter-roster-heading">Organizations acknowledged as supporters</h2>
        <p>All organizations receive the same presentation. Logo dimensions reflect the source artwork and do not indicate a giving or supporter level.</p>
      </header>
      <ul aria-labelledby="supporter-roster-heading">
        {supporters.map((supporter) => (
          <li>
            <div class="supporter-logo-frame">
              <img src={supporter.logo} alt={supporter.alt} loading="lazy" decoding="async" />
            </div>
            <h3>{supporter.name}</h3>
          </li>
        ))}
      </ul>
    </section>

    <section class="acknowledgment-distinction" aria-labelledby="supporter-distinction-heading" data-editable="source" data-path="/src/pages/supporters/index.astro" data-key="supporters-donor-distinction">
      <p class="section-kicker">A separate public record</p>
      <h2 id="supporter-distinction-heading">Looking for donor acknowledgments?</h2>
      <p>Donors are recognized by fiscal year from the public Little Green Light report. The supporter roster above is not generated from donor data.</p>
      <a class="text-action" href="/donors/">View Donors</a>
    </section>

    <ActionBand
      kicker="Join the work"
      title="Start a conversation about participating."
      text="Explore current ways to attend, join a committee, request a presentation, or receive updates."
      primaryLabel="Join the Work"
      primaryHref="/join-the-work/"
      secondaryLabel="Impact and accountability"
      secondaryHref="/impact/"
    />
  </main>
</BaseLayout>
