---
import ActionBand from "@/components/ActionBand.astro";
import Breadcrumbs from "@/components/Breadcrumbs.astro";
import PageIntro from "@/components/PageIntro.astro";
import SourceNotice from "@/components/SourceNotice.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
---

<BaseLayout pageType="WebPage" title="Impact, Supporters, and Accountability | Justice League GLM" description="Review verified Justice League GLM scholarship, homeownership, supporter, and donor records with links to the current public sources.">
  <main id="main-content" class="interior-page" tabindex="-1">
    <Breadcrumbs items={[{ label: "Home", href: "/" }, { label: "Impact and accountability" }]} />
    <PageIntro kicker="Evidence before claims" title="Impact and Accountability" lede="A dated public record of scholarship, homeownership, community support, and the evidence still needed for complete reporting." mode="evidence" marker="Show the work" />
    <SourceNotice title="Records reviewed across the current timeline, scholarship, supporters, and donors pages" />

    <section class="accountability-grid" aria-labelledby="reporting-standard"><div><p class="section-kicker">Required for every claim</p><h2 id="reporting-standard">Evidence should explain itself.</h2></div><ol><li><span>01</span><strong>Reporting period</strong><p>State exactly when the activity occurred.</p></li><li><span>02</span><strong>Method and source</strong><p>Explain how the information was produced and where it can be checked.</p></li><li><span>03</span><strong>Limits and ownership</strong><p>Name what the evidence does not show, who approved it, and when it will be reviewed.</p></li></ol></section>

    <section class="provisional-evidence" aria-labelledby="available-record"><div><p class="section-kicker">Current-site evidence</p><h2 id="available-record">Program activity with dates and sources.</h2></div><dl><div><dt>2024 scholarship cohort</dt><dd>Ten publicly named recipients; the timeline records awards of $5,000 each</dd></div><div><dt>2025 scholarship cohort</dt><dd>Ten publicly named recipients; the timeline records awards of $2,500 each</dd></div><div><dt>2026 scholarship cohort</dt><dd>Ten publicly named recipients and published essays</dd></div><div><dt>Homeownership</dt><dd>The timeline records a 2025 home build with the Eastside Community Action Center and a second build underway later that year</dd></div></dl><a class="text-action" href="/scholarship/">Review recipients and published essays</a><a class="text-action" href="/about/history/">Review the dated timeline</a></section>

    <section class="acknowledgment-index" aria-labelledby="acknowledgment-index-heading">
      <header>
        <p class="section-kicker">Two public records</p>
        <h2 id="acknowledgment-index-heading">Supporters and donors remain distinct.</h2>
      </header>
      <div>
        <article>
          <p class="section-index">01 / Curated organizations</p>
          <h3>Repairers of the Breach</h3>
          <p>See the current community and organizational supporters with the logos paired to them on the published supporter record.</p>
          <a class="text-action" href="/supporters/">View Supporters</a>
        </article>
        <article>
          <p class="section-index">02 / Yearly acknowledgment</p>
          <h3>Reparations payees and administration donors</h3>
          <p>Read the donor names directly on this site, grouped by fiscal year from the public Little Green Light report.</p>
          <a class="text-action" href="/donors/">View Donors</a>
        </article>
      </div>
    </section>

    <section class="withheld-section" aria-labelledby="withheld-heading"><p class="section-kicker">Still not established</p><h2 id="withheld-heading">Claims that need a reconciled reporting source.</h2><ul><li>A single current endowment balance—the timeline cites different dated milestones</li><li>Administrative and program spending</li><li>Donor, congregation, member, presentation, and attendance totals</li><li>Long-term scholarship, homeownership, and business-development outcomes</li><li>A current audited financial or annual report</li></ul></section>
    <ActionBand kicker="Governance connection" title="Accountability includes who reviews the record." text="See the current leadership roster or contact the organization with a correction." primaryLabel="Leadership and governance" primaryHref="/about/leadership/" secondaryLabel="Contact" secondaryHref="/contact/" />
  </main>
</BaseLayout>
