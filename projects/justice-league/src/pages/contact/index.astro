---
import ActionBand from "@/components/ActionBand.astro";
import Breadcrumbs from "@/components/Breadcrumbs.astro";
import PageIntro from "@/components/PageIntro.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { site } from "@/data/site";
import pageMeta from "@/content/pages/contact.json";
---

<BaseLayout pageType="WebPage" title={pageMeta.seo_title} description={pageMeta.meta_description}>
  <main id="main-content" class="interior-page" tabindex="-1">
    <Breadcrumbs items={[{ label: "Home", href: "/" }, { label: "Contact" }]} />
    <PageIntro kicker="General inquiry" title="Contact the Justice League" lede="Ask about scholarships, meetings, committees, presentations, events, donations, or the wider reparations work." mode="documentary" marker="Start a conversation" />
    <section class="contact-orientation" aria-labelledby="contact-routing"><div><p class="section-kicker">Public contact details</p><h2 id="contact-routing">Email or write to the organization.</h2></div><address><a href={`mailto:${site.email}`}>{site.email}</a><br />{site.mailingAddress.line1}<br />{site.mailingAddress.line2}</address><ul><li>Join a committee</li><li>Attend a general meeting</li><li>Request a presentation</li><li>Scholarship or event question</li><li>Donation or general inquiry</li></ul></section>
    <section class="contact-orientation" aria-labelledby="email-guidance"><div><p class="section-kicker">Email the Justice League</p><h2 id="email-guidance">Start your message with the details that will help us respond.</h2></div><p>Include your name, a return email address, and the topic of your question. Please do not send private financial, medical, or other sensitive information by email.</p><a class="button button-primary" href={`mailto:${site.email}?subject=Justice%20League%20GLM%20inquiry`}>Email {site.email}</a></section>
    <ActionBand kicker="Participation inquiry" title="Looking for a way to take part?" text="The Join page separates general meetings, committee interest, presentation requests, and email updates." primaryLabel="Join the Work" primaryHref="/join-the-work/" secondaryLabel="Privacy" secondaryHref="/privacy/" />
  </main>
</BaseLayout>
