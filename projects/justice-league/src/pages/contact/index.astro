---
import ActionBand from "@/components/ActionBand.astro";
import Breadcrumbs from "@/components/Breadcrumbs.astro";
import PageIntro from "@/components/PageIntro.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { currentWixRoutes, site } from "@/data/site";
import pageMeta from "@/content/pages/contact.json";
---

<BaseLayout pageType="WebPage" title={pageMeta.seo_title} description={pageMeta.meta_description}>
  <main id="main-content" class="interior-page" tabindex="-1">
    <Breadcrumbs items={[{ label: "Home", href: "/" }, { label: "Contact" }]} />
    <PageIntro kicker="General inquiry" title="Contact the Justice League" lede="Ask about the scholarship, meetings, committees, presentations, events, donations, or the wider reparations work." mode="documentary" marker="Start a conversation">
      <span slot="kicker" data-editable="source" data-path="/src/pages/contact/index.astro" data-key="contact-intro-kicker">General inquiry</span>
      <span slot="title" data-editable="source" data-path="/src/pages/contact/index.astro" data-key="contact-intro-title">Contact the Justice League</span>
      <span slot="lede" data-editable="source" data-path="/src/pages/contact/index.astro" data-key="contact-intro-lede">Ask about the scholarship, meetings, committees, presentations, events, donations, or the wider reparations work.</span>
      <span slot="marker" data-editable="source" data-path="/src/pages/contact/index.astro" data-key="contact-intro-marker">Start a conversation</span>
    </PageIntro>
    <section class="contact-orientation" aria-labelledby="contact-routing"><div><p class="section-kicker">Public contact details</p><h2 id="contact-routing">Email or write to the organization.</h2></div><address><a href={`mailto:${site.email}`}>{site.email}</a><br />{site.mailingAddress.line1}<br />{site.mailingAddress.line2}</address><ul><li>Join a committee</li><li>Attend a general meeting</li><li>Request a presentation</li><li>Scholarship or event question</li><li>Donation or general inquiry</li></ul><a class="text-action" href={currentWixRoutes.contact} target="_blank" rel="noreferrer">Use the current Wix contact form <span class="visually-hidden">(opens in a new tab)</span></a></section>
    <section class="contact-orientation" aria-labelledby="contact-form-heading"><div><p class="section-kicker">Email the Justice League</p><h2 id="contact-form-heading">Start your message with the details that will help us respond.</h2></div><p>Include your name, return email address, and topic. Please do not send private financial, medical, or other sensitive information by email.</p><a class="button button-primary" href={`mailto:${site.email}?subject=Justice%20League%20GLM%20inquiry`}>Email {site.email}</a></section>
    <ActionBand kicker="Participation inquiry" title="Looking for a way to take part?" text="The Join page separates general meetings, committee interest, presentation requests, and email updates." primaryLabel="Join the Work" primaryHref="/join-the-work/" secondaryLabel="Privacy shell" secondaryHref="/privacy/" />
  </main>
</BaseLayout>
