---
import ActionBand from "@/components/ActionBand.astro";
import Breadcrumbs from "@/components/Breadcrumbs.astro";
import PageIntro from "@/components/PageIntro.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { getCurrentScholarshipCycle, getPublishedScholarshipRecipients } from "@/lib/wix";

const [scholarshipResult, recipientResult] = await Promise.all([
  getCurrentScholarshipCycle(),
  getPublishedScholarshipRecipients()
]);
const cycle = scholarshipResult.state === "success" || scholarshipResult.state === "stale"
  ? scholarshipResult.cycle
  : undefined;
const recipients = recipientResult.state === "success" || recipientResult.state === "stale"
  ? recipientResult.recipients
  : [];
const cohorts = recipientResult.state === "success" || recipientResult.state === "stale"
  ? recipientResult.cohorts
  : [];
const recipientYears = [...new Set(recipients.map((recipient) => recipient.year))].sort((a, b) => b - a);
const newestRecipientYear = recipientYears[0];

const statusLabels = {
  active: "Applications are open",
  closed: "Applications are closed",
  upcoming: "Applications have not opened",
  paused: "Applications are paused"
} as const;

function formatDate(value?: string) {
  if (!value) return undefined;
  return new Intl.DateTimeFormat("en-US", {
    month: "long",
    day: "numeric",
    year: "numeric",
    timeZone: "UTC"
  }).format(new Date(`${value}T12:00:00Z`));
}

function formatAward(amount?: number, currency = "USD") {
  if (typeof amount !== "number") return undefined;
  return new Intl.NumberFormat("en-US", {
    style: "currency",
    currency,
    maximumFractionDigits: 0
  }).format(amount);
}

const contactHref = cycle?.contactEmail ? `mailto:${cycle.contactEmail}` : "/contact/";
const contactLabel = cycle?.contactEmail ? `Email ${cycle.contactEmail}` : "Contact the organization";
const unavailableMessage = "message" in scholarshipResult
  ? scholarshipResult.message
  : "Scholarship information is unavailable.";
---

<BaseLayout
  pageType="WebPage"
  title="Reparations Scholarship | Justice League GLM"
  description="Check the current Justice League GLM Reparations Scholarship status, award structure, eligibility, dates, required materials, and contact information."
>
  <main id="main-content" class="interior-page">
    <Breadcrumbs items={[{ label: "Home", href: "/" }, { label: "Scholarship" }]} />
    <PageIntro
      kicker="Program status"
      title="Reparations Scholarship"
      lede={cycle ? `${cycle.cycleLabel} cycle information is maintained in Wix CMS. Status comes before eligibility and application details.` : "Scholarship information cannot be presented safely until Wix CMS provides a complete published cycle."}
      mode="campaign"
      marker={cycle?.cycleLabel ?? "Status unavailable"}
    />

    {scholarshipResult.state === "stale" && (
      <aside class="cms-state-notice" aria-label="Scholarship content freshness">
        <strong>Stale source snapshot</strong>
        <p>{scholarshipResult.message} Source observed {formatDate(cycle?.sourceObservedAt)}.</p>
      </aside>
    )}

    {cycle ? (
      <>
        <section class={`status-banner scholarship-status scholarship-status--${cycle.publicStatus}`} aria-labelledby="cycle-status">
          <p class="section-kicker">{cycle.cycleLabel} cycle</p>
          <h2 id="cycle-status">{statusLabels[cycle.publicStatus]}</h2>
          <p>{cycle.statusMessage}</p>
          {cycle.publicStatus === "active" && cycle.applicationUrl ? (
            <a class="button button-secondary" href={cycle.applicationUrl} target="_blank" rel="noreferrer">Open the verified application <span class="visually-hidden">(opens in a new tab)</span></a>
          ) : (
            <a class="button button-secondary" href={contactHref}>{contactLabel}</a>
          )}
        </section>

        <aside class="source-notice" aria-label="Scholarship CMS source">
          <strong>Wix CMS record · {cycle.reviewStatus}</strong>
          <p>
            Published from the `ScholarshipCycles` collection and checked against the current site observed {formatDate(cycle.sourceObservedAt)}.
            <a href={cycle.sourceUrl} target="_blank" rel="noreferrer">Review the current Wix source <span class="visually-hidden">(opens in a new tab)</span></a>.
          </p>
        </aside>

        <section class="scholarship-dates" aria-labelledby="cycle-dates">
          <div>
            <p class="section-kicker">Cycle chronology</p>
            <h2 id="cycle-dates">Dates without stale urgency.</h2>
          </div>
          <dl>
            {cycle.applicationOpenDate && <div><dt>Applications opened</dt><dd><time datetime={cycle.applicationOpenDate}>{formatDate(cycle.applicationOpenDate)}</time></dd></div>}
            {cycle.applicationDeadline && <div><dt>Extended deadline</dt><dd><time datetime={cycle.applicationDeadline}>{formatDate(cycle.applicationDeadline)}</time></dd></div>}
            {cycle.recipientNotificationDate && <div><dt>Notification date</dt><dd><time datetime={cycle.recipientNotificationDate}>{formatDate(cycle.recipientNotificationDate)}</time></dd></div>}
          </dl>
        </section>

        <section class="fact-ledger" aria-labelledby="scholarship-snapshot">
          <div>
            <p class="section-kicker">Program snapshot</p>
            <h2 id="scholarship-snapshot">Education as a reparations pathway.</h2>
            <p>These terms describe the closed {cycle.cycleLabel} cycle. They do not promise that a future cycle will use the same terms.</p>
          </div>
          <dl>
            {typeof cycle.awardCount === "number" && <div><dt>Planned recipients</dt><dd>{cycle.awardCount} qualifying individuals</dd></div>}
            {typeof cycle.awardAmount === "number" && <div><dt>Award amount</dt><dd>{formatAward(cycle.awardAmount, cycle.awardCurrency)} each</dd></div>}
            <div><dt>Study pathways</dt><dd>Accredited college, university, or vocational school</dd></div>
          </dl>
        </section>

        <section class="scholarship-criteria" aria-labelledby="eligibility-heading">
          <div class="section-heading-row">
            <p class="section-kicker">Eligibility snapshot</p>
            <h2 id="eligibility-heading">Who the closed cycle was designed to serve.</h2>
          </div>
          <div class="criteria-ledgers">
            <section aria-labelledby="applicant-types">
              <h3 id="applicant-types">Applicant types</h3>
              <ul>{cycle.eligibleApplicantTypes.map((item) => <li>{item}</li>)}</ul>
            </section>
            <section aria-labelledby="eligible-counties">
              <h3 id="eligible-counties">Residency</h3>
              <p>Applicants were required to live in one of these Greater Lansing counties:</p>
              <ul>{cycle.eligibleCounties.map((county) => <li>{county} County</li>)}</ul>
            </section>
          </div>
        </section>

        <section class="scholarship-materials" aria-labelledby="materials-heading">
          <div>
            <p class="section-kicker">Closed-cycle requirements</p>
            <h2 id="materials-heading">What a complete submission required.</h2>
          </div>
          <div class="materials-ledgers">
            <section aria-labelledby="documents-heading">
              <h3 id="documents-heading">Required materials</h3>
              <ol>{cycle.requiredDocuments.map((item, index) => <li><span>{String(index + 1).padStart(2, "0")}</span>{item}</li>)}</ol>
            </section>
            <section aria-labelledby="topics-heading">
              <h3 id="topics-heading">Essay topic choices</h3>
              <ul>{cycle.essayTopics.map((topic) => <li>{topic}</li>)}</ul>
              <a class="text-action" href="/reparations/">Understand the reparations context</a>
            </section>
          </div>
        </section>

        <section class="scholarship-source-detail" aria-labelledby="source-detail-heading">
          <div>
            <p class="section-kicker">Source and contact</p>
            <h2 id="source-detail-heading">A closed cycle still needs a correction path.</h2>
          </div>
          <div>
            {cycle.sourceNote && <p class="source-discrepancy"><strong>Source note:</strong> {cycle.sourceNote}</p>}
            <dl class="check-instructions">
              {cycle.contactEmail && <div><dt>Email</dt><dd><a href={`mailto:${cycle.contactEmail}`}>{cycle.contactEmail}</a></dd></div>}
              {cycle.mailingAddress && <div><dt>Mail</dt><dd class="multiline-value">{cycle.mailingAddress}</dd></div>}
            </dl>
            <p>Contact the organization before mailing application materials after a published deadline. This page does not imply that late submissions are accepted.</p>
          </div>
        </section>

        <section class="recipient-archive" aria-labelledby="recipient-archive-heading">
          <div class="recipient-archive-intro">
            <div>
              <p class="section-kicker">Published recipient record</p>
              <h2 id="recipient-archive-heading">Scholarship recipients and essays.</h2>
            </div>
            <div>
              <p>These are scholarship recipients publicly identified by the Justice League—not the full applicant pool. Names, education details, essay links, and the available group photograph are reproduced with client approval from the current Wix site.</p>
              <p class="recipient-source">Wix CMS collections: <code>ScholarshipRecipients</code> and <code>ScholarshipCohorts</code>.</p>
            </div>
          </div>

          {recipientResult.state === "stale" && (
            <aside class="recipient-freshness" aria-label="Recipient content freshness">
              <strong>Dated source snapshot</strong>
              <p>{recipientResult.message} Source observed August 7, 2026.</p>
            </aside>
          )}

          {recipients.length ? (
            <div class="recipient-years">
              {recipientYears.map((year) => {
                const yearRecipients = recipients.filter((recipient) => recipient.year === year);
                const cohort = cohorts.find((record) => record.year === year && record.imageUrl);
                return (
                  <details class="recipient-year" open={year === newestRecipientYear}>
                    <summary>
                      <span>{year}</span>
                      <strong>{yearRecipients.length} published recipients</strong>
                      <i aria-hidden="true">
                        <span class="summary-open-label">Open record</span>
                        <span class="summary-close-label">Close record</span>
                      </i>
                    </summary>
                    <div class="recipient-year-content">
                      {cohort?.imageUrl && cohort.imageAlt && (
                        <figure class="cohort-documentary">
                          <img
                            src={cohort.imageUrl}
                            alt={cohort.imageAlt}
                            width="1222"
                            height="726"
                            loading="lazy"
                            decoding="async"
                          />
                          {cohort.imageCaption && <figcaption>{cohort.imageCaption}</figcaption>}
                        </figure>
                      )}
                      <ol class="recipient-ledger">
                        {yearRecipients.map((recipient) => (
                          <li>
                            <span class="recipient-index">{String(recipient.displayOrder).padStart(2, "0")}</span>
                            <div class="recipient-identity">
                              <h3>{recipient.name}</h3>
                              <p>{recipient.city}, Michigan</p>
                            </div>
                            <dl>
                              <div><dt>High school</dt><dd>{recipient.highSchool}</dd></div>
                              <div><dt>Continuing education</dt><dd>{recipient.institution}</dd></div>
                            </dl>
                            <a href={recipient.essayUrl} target="_blank" rel="noreferrer">
                              Read published essay
                              <span>{recipient.essayFormat}</span>
                              <span class="visually-hidden"> by {recipient.name} (opens in a new tab)</span>
                            </a>
                          </li>
                        ))}
                      </ol>
                    </div>
                  </details>
                );
              })}
            </div>
          ) : (
            <div class="recipient-empty" role="status">
              <h3>Recipient records are temporarily unavailable.</h3>
              <p>{"message" in recipientResult ? recipientResult.message : "No approved recipient records are available."}</p>
            </div>
          )}
        </section>
      </>
    ) : (
      <section class="unavailable-action" aria-labelledby="scholarship-unavailable">
        <p class="section-kicker">CMS state · {scholarshipResult.state}</p>
        <h2 id="scholarship-unavailable">Scholarship information is unavailable.</h2>
        <p>{unavailableMessage}</p>
        <p>No application status, deadline, or eligibility terms are substituted from an unverified record.</p>
        <a class="button button-secondary" href="/contact/">Contact the organization</a>
      </section>
    )}

    <ActionBand
      kicker="Support the pathway"
      title="Connect scholarship interest to reparations work."
      text="No allocation or future-cycle claim is made until financial and program evidence is approved."
      primaryLabel="Support Reparations"
      primaryHref="/support-reparations/"
      secondaryLabel="Impact and accountability"
      secondaryHref="/impact/"
    />
  </main>
</BaseLayout>
