---
import ActionBand from "@/components/ActionBand.astro";
import Breadcrumbs from "@/components/Breadcrumbs.astro";
import PageIntro from "@/components/PageIntro.astro";
import { currentWixRoutes } from "@/data/site";
import { getUpcomingPublicEvents } from "@/lib/wix";
import BaseLayout from "@/layouts/BaseLayout.astro";
import pageMeta from "@/content/pages/events.json";

const eventsResult = await getUpcomingPublicEvents();
const events = eventsResult.state === "success" ? eventsResult.events : [];
const fallbackMessage = eventsResult.state === "success" ? "" : eventsResult.message;
---

<BaseLayout pageType="WebPage" title={pageMeta.seo_title} description={pageMeta.meta_description}>
  <main id="main-content" class="interior-page" tabindex="-1">
    <Breadcrumbs items={[{ label: "Home", href: "/" }, { label: "Events" }]} />
    <PageIntro kicker="Event discovery" title="Events and Meetings" lede="Find current Justice League events, community gatherings, and ways to participate." mode="campaign" marker="What is next">
      <span slot="kicker" data-editable="source" data-path="/src/pages/events/index.astro" data-key="events-intro-kicker">Event discovery</span>
      <span slot="title" data-editable="source" data-path="/src/pages/events/index.astro" data-key="events-intro-title">Events and Meetings</span>
      <span slot="lede" data-editable="source" data-path="/src/pages/events/index.astro" data-key="events-intro-lede">Find current Justice League events, community gatherings, and ways to participate.</span>
      <span slot="marker" data-editable="source" data-path="/src/pages/events/index.astro" data-key="events-intro-marker">What is next</span>
    </PageIntro>

    <section class="campaign-callout" aria-labelledby="ad-booklet-campaign" data-editable="source" data-path="/src/pages/events/index.astro" data-key="events-ad-booklet">
      <div><p class="section-kicker">Current campaign</p><h2 id="ad-booklet-campaign">2026 Fall Celebration Ad Booklet</h2></div>
      <div><p>Program-book advertisements are due <time datetime="2026-09-30">September 30, 2026</time>. Compare the four current-site placements and review the Wix submission handoff.</p><a class="text-action" href="/ad-booklet/">Review ad booklet opportunities</a></div>
    </section>

    <section class="state-review" aria-labelledby="current-events">
      <div class="section-heading-row"><p class="section-kicker">Wix Events · {eventsResult.state}</p><h2 id="current-events">Current public events.</h2></div>
      {events.length ? (
        <ol class="upcoming-list">
          {events.map((event) => (
            <li>
              <p class="event-date"><time datetime={event.startsAt}>{event.formattedDate}</time></p>
              <h3>{event.title}</h3>
              <p>{event.formattedTime}{event.location ? ` · ${event.location}` : ""}</p>
              <a class="text-action" href={event.eventUrl} target="_blank" rel="noreferrer">{event.actionLabel} <span class="visually-hidden">(opens in a new tab)</span></a>
            </li>
          ))}
        </ol>
      ) : (
        <div class:list={["status-banner", eventsResult.state === "error" && "status-banner--warning"]} role={eventsResult.state === "error" ? "status" : undefined}>
          <h3>{eventsResult.state === "error" ? "Current events could not be loaded." : "No public upcoming events are listed."}</h3>
          <p>{fallbackMessage}</p>
          <a class="text-action" href={currentWixRoutes.events} target="_blank" rel="noreferrer">View event registration <span class="visually-hidden">(opens in a new tab)</span></a>
        </div>
      )}
    </section>

    <section class="campaign-callout" aria-labelledby="meeting-schedule" data-editable="source" data-path="/src/pages/events/index.astro" data-key="events-meetings">
      <div><p class="section-kicker">Organization meetings</p><h2 id="meeting-schedule">General and committee meetings.</h2></div>
      <div><p>The Justice League offers general, finance, resource development, public relations, advisory council, and administration meetings. Contact the organization for the next meeting details.</p><a class="text-action" href="/contact/">Contact the Justice League</a></div>
    </section>

    <section class="state-review" aria-labelledby="event-states">
      <div class="section-heading-row"><p class="section-kicker">Integration behavior</p><h2 id="event-states">Changing states stay explicit.</h2></div>
      <div class="state-stack">
        <details><summary><span class="state-dot state-dot--active"></span>Active record requirements</summary><div><h3>Every public event needs a complete record.</h3><p>Date, time zone, location, cost, accessibility, availability, and one maintained registration destination should travel together.</p><a class="text-action" href="/events/demo-priority/">Review the demonstration detail</a></div></details>
        <details><summary><span class="state-dot"></span>Past or closed</summary><div><h3>Registration has ended</h3><p>A useful past record can retain its verified context while removing the transactional action.</p></div></details>
        <details><summary><span class="state-dot"></span>Empty</summary><div><h3>No upcoming events are available</h3><p>The page offers stable participation routes instead of substituting an expired event.</p></div></details>
        <details><summary><span class="state-dot state-dot--error"></span>Error</summary><div><h3>Events could not be loaded</h3><p>No cached or invented event is presented as current. Visitors receive a Wix and contact fallback.</p></div></details>
      </div>
    </section>

    <section class="fact-standard" aria-labelledby="event-standard"><p class="section-kicker">Required event record</p><h2 id="event-standard">Facts before registration.</h2><dl><div><dt>When</dt><dd>Date, start/end time, and time zone</dd></div><div><dt>Where</dt><dd>Verified venue or virtual access details</dd></div><div><dt>Access</dt><dd>Cost, capacity, accommodations, and contact</dd></div><div><dt>Action</dt><dd>Allowlisted Wix RSVP or ticket URL with a maintained status</dd></div></dl></section>
    <ActionBand kicker="Between events" title="Participation remains available year-round." text="Ask about general meetings, committees, presentations, or email updates." primaryLabel="Join the Work" primaryHref="/join-the-work/" secondaryLabel="Contact" secondaryHref="/contact/" />
  </main>
</BaseLayout>
