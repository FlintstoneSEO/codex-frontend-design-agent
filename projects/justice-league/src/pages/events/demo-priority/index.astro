---
import ActionBand from "@/components/ActionBand.astro";
import Breadcrumbs from "@/components/Breadcrumbs.astro";
import PageIntro from "@/components/PageIntro.astro";
import { demoEvent } from "@/data/content";
import BaseLayout from "@/layouts/BaseLayout.astro";
---

<BaseLayout title="Demonstration Event Detail | Justice League GLM Prototype" description="A noindex demonstration of the verified facts and registration states required for a future Justice League GLM event page.">
  <main id="main-content" class="interior-page">
    <Breadcrumbs items={[{ label: "Home", href: "/" }, { label: "Events", href: "/events/" }, { label: "Demonstration detail" }]} />
    <div class="demo-rail" role="note"><strong>Demonstration fixture</strong><span>This is not a real event, meeting, invitation, date, venue, or deadline.</span></div>
    <PageIntro kicker="Prototype event detail" title={demoEvent.title} lede={demoEvent.description} mode="campaign" marker="Not a real event" />
    <section class="event-detail-ledger" aria-labelledby="event-facts"><div><p class="section-kicker">Required fact pattern</p><h2 id="event-facts">What a complete event record must answer.</h2></div><dl><div><dt>Status</dt><dd>Demonstration only</dd></div><div><dt>Date and time</dt><dd>[NEEDS CLIENT INPUT: Verified date, time, and time zone]</dd></div><div><dt>Location</dt><dd>[NEEDS CLIENT INPUT: Venue or virtual-access details]</dd></div><div><dt>Cost and availability</dt><dd>[NEEDS CLIENT INPUT: Ticket or RSVP terms and current status]</dd></div><div><dt>Accessibility</dt><dd>[NEEDS CLIENT INPUT: Venue access, accommodations, and request contact]</dd></div><div><dt>Organizer</dt><dd>[NEEDS CLIENT INPUT: Approved organizer and event contact]</dd></div></dl></section>
    <section class="definition-block" aria-labelledby="event-description"><p class="section-kicker">Description placement</p><h2 id="event-description">Context belongs beside logistics.</h2><p>[PLACEHOLDER: An approved event description would explain the purpose, audience, program, speakers, sponsors, and relevant policies.]</p></section>
    <section class="unavailable-action" aria-labelledby="registration-heading"><p class="section-kicker">Registration handoff</p><h2 id="registration-heading">No transaction is available.</h2><p>A live action will appear only after its HTTPS Wix destination, event identity, availability, and transaction purpose are verified.</p><code>[NEEDS CLIENT INPUT: Verify Wix event destination]</code></section>
    <ActionBand kicker="Return to verified paths" title="Review current participation options." text="The demonstration cannot accept a registration or payment." primaryLabel="Back to events" primaryHref="/events/" secondaryLabel="Join the Work" secondaryHref="/join-the-work/" />
  </main>
</BaseLayout>
