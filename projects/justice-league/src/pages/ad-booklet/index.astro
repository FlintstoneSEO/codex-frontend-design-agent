---
import ActionBand from "@/components/ActionBand.astro";
import Breadcrumbs from "@/components/Breadcrumbs.astro";
import PageIntro from "@/components/PageIntro.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import pageMeta from "@/content/pages/ad-booklet.json";

const wixCampaignUrl = "https://www.justiceleagueglm.org/ad-booklet";

const placements = [
  { name: "Full-page ad", dimensions: "7½ × 10 inches", price: "$400" },
  { name: "Half-page ad", dimensions: "7 × 4¾ inches", price: "$250" },
  { name: "Quarter-page ad", dimensions: "4½ × 3¼ inches", price: "$125" },
  { name: "Business-card ad", dimensions: "4 × 2 inches", price: "$75" }
] as const;

const adBookletForms = [
  {
    heading: "Online payment form",
    name: "Online Ad Booklet Form",
    id: "619eb4d2-04dc-415a-9d9d-d962ca47b424",
    href: `${wixCampaignUrl}#online-form`,
    description: "Use this form to enter advertiser contact details, choose ad quantities, upload artwork, and pay online.",
    details: ["Wix payment field", "File upload field", "Business contact fields"]
  },
  {
    heading: "Check payment form",
    name: "Check Ad Booklet Form",
    id: "69e07670-5f12-44b0-ade5-3dc341f40260",
    href: `${wixCampaignUrl}#check-form`,
    description: "Use this form to submit advertiser details and artwork when payment will be mailed by check.",
    details: ["Quantity fields by ad size", "File upload field", "Check acknowledgement fields"]
  }
] as const;
---

<BaseLayout
  pageType="WebPage"
  title={pageMeta.seo_title}
  description={pageMeta.meta_description}
>
  <main id="main-content" class="interior-page" tabindex="-1">
    <Breadcrumbs items={[{ label: "Home", href: "/" }, { label: "Events", href: "/events/" }, { label: "2026 Ad Booklet" }]} />

    <PageIntro
      kicker="Five-year Fall Celebration"
      title="2026 Fall Celebration Ad Booklet"
      lede="Share a message of congratulations, support, or encouragement in the Justice League’s 2026 program booklet."
      mode="campaign"
      marker="Ads due / Sep 30"
    >
      <span slot="kicker" data-editable="source" data-path="/src/pages/ad-booklet/index.astro" data-key="ad-booklet-intro-kicker">Five-year Fall Celebration</span>
      <span slot="title" data-editable="source" data-path="/src/pages/ad-booklet/index.astro" data-key="ad-booklet-intro-title">2026 Fall Celebration Ad Booklet</span>
      <span slot="lede" data-editable="source" data-path="/src/pages/ad-booklet/index.astro" data-key="ad-booklet-intro-lede">Share a message of congratulations, support, or encouragement in the Justice League’s 2026 program booklet.</span>
      <span slot="marker" data-editable="source" data-path="/src/pages/ad-booklet/index.astro" data-key="ad-booklet-intro-marker">Ads due / Sep 30</span>
    </PageIntro>

    <aside class="source-notice" aria-label="Campaign source status">
      <strong>Active current-site campaign</strong>
      <p>
        Details were verified against the organization’s current Wix page and form schemas. The submission and payment workflow is attached below through the active Wix forms.
        <a href={wixCampaignUrl} target="_blank" rel="noreferrer">Review the current Wix campaign <span class="visually-hidden">(opens in a new tab)</span></a>.
      </p>
    </aside>

    <section class="status-banner status-banner--warning" aria-labelledby="ad-deadline">
      <p class="section-kicker">Submission deadline</p>
      <h2 id="ad-deadline"><time datetime="2026-09-30">September 30, 2026</time></h2>
      <p>No countdown or availability claim is used. Confirm any late submission directly with the organization.</p>
      <a class="button button-secondary" href="#ad-booklet-forms">Go to forms</a>
    </section>

    <section class="campaign-orientation" aria-labelledby="campaign-fit" data-editable="source" data-path="/src/pages/ad-booklet/index.astro" data-key="ad-booklet-orientation">
      <div>
        <p class="section-kicker">Who the invitation is for</p>
        <h2 id="campaign-fit">Mark the occasion with a message of support.</h2>
      </div>
      <div class="campaign-orientation-copy">
        <p>The current campaign invites businesses, houses of worship, community partners, and supporters to purchase space in the 2026 Fall Celebration program booklet.</p>
        <p>The source page identifies congratulations, support, and encouragement as appropriate message types. It does not publish circulation, attendance, or audience-reach claims.</p>
      </div>
    </section>

    <section class="ad-placement-section" aria-labelledby="placement-heading">
      <div class="section-heading-row">
        <p class="section-kicker">Placement ledger</p>
        <h2 id="placement-heading">Choose the space that fits your message.</h2>
      </div>
      <dl class="ad-placement-ledger">
        {placements.map((placement, index) => (
          <div>
            <dt><span>{String(index + 1).padStart(2, "0")}</span>{placement.name}</dt>
            <dd><span>{placement.dimensions}</span><strong>{placement.price}</strong></dd>
          </div>
        ))}
      </dl>
      <p class="source-line">Prices and dimensions reflect the current Wix campaign as observed August 7, 2026.</p>
    </section>

    <section class="process-section" aria-labelledby="ad-process" data-editable="source" data-path="/src/pages/ad-booklet/index.astro" data-key="ad-booklet-process">
      <div class="section-heading-row">
        <p class="section-kicker">Submission process</p>
        <h2 id="ad-process">Three decisions, then a secure handoff.</h2>
      </div>
      <ol class="process-list">
        <li><span>01</span><div><h3>Select your placement</h3><p>Choose one or more ad sizes in the attached Wix form.</p></div></li>
        <li><span>02</span><div><h3>Prepare and upload your ad</h3><p>Submit a camera-ready JPG, PNG, DOC/DOCX, or PDF through the Wix upload field.</p></div></li>
        <li><span>03</span><div><h3>Choose online or check payment</h3><p>Complete payment online or submit the check-payment form and mail payment separately.</p></div></li>
      </ol>
    </section>

    <section class="submission-paths" id="ad-booklet-forms" aria-labelledby="submission-heading">
      <div class="submission-paths-intro">
        <p class="section-kicker">Complete the submission</p>
        <h2 id="submission-heading">Choose the form that matches your payment method.</h2>
        <p>The live Wix forms remain the system of record for advertiser information, file uploads, quantities, receipts, and payment status.</p>
      </div>
      <div class="submission-path-list">
        {adBookletForms.map((form) => (
          <article class="attached-form-card" data-wix-form-id={form.id}>
            <p class="section-index">{form.heading}</p>
            <h3>{form.name}</h3>
            <p>{form.description}</p>
            <ul aria-label={`${form.name} includes`}>
              {form.details.map((detail) => <li>{detail}</li>)}
            </ul>
            <a class="button button-primary" href={form.href} target="_blank" rel="noreferrer">Open {form.heading} <span class="visually-hidden">(opens in a new tab)</span></a>
            <p class="form-source-id">Wix form ID: <code>{form.id}</code></p>
          </article>
        ))}
      </div>
    </section>

    <section class="evidence-note" aria-labelledby="check-payment-instructions" data-editable="source" data-path="/src/pages/ad-booklet/index.astro" data-key="ad-booklet-check-payment">
      <p class="section-kicker">Check payment instructions</p>
      <h2 id="check-payment-instructions">Mail checks after submitting the check form.</h2>
      <dl class="check-instructions">
        <div><dt>Payable to</dt><dd>Justice League of Greater Lansing Michigan</dd></div>
        <div><dt>Mail to</dt><dd>P.O. Box 12105<br />Lansing, MI 48901</dd></div>
        <div><dt>Memo</dt><dd>Include your business or organization name</dd></div>
      </dl>
      <p>Ad placement is confirmed after the organization receives the form submission, artwork, and payment.</p>
    </section>

    <ActionBand
      kicker="Beyond the booklet"
      title="Follow the celebration or ask a campaign question."
      text="Event details and campaign support remain separate so advertisers can find the right next step."
      primaryLabel="Explore Events"
      primaryHref="/events/"
      secondaryLabel="Contact"
      secondaryHref="/contact/"
    />
  </main>
</BaseLayout>
