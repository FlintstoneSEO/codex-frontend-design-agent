---
interface Props {
  kind: "join" | "contact";
}
const { kind } = Astro.props;
const isJoin = kind === "join";
const prefix = `prototype-${kind}`;
---

<form class="prototype-form" data-prototype-form={kind} novalidate>
  <div class="form-warning">
    <strong>Non-submitting prototype form</strong>
    <p>No information entered here is transmitted or stored.</p>
  </div>
  <p class="required-note">All fields are required for this validation demonstration.</p>
  <div class="form-grid">
    <div class="field-group">
      <label for={`${prefix}-name`}>Name</label>
      <input id={`${prefix}-name`} name="name" autocomplete="name" aria-describedby={`${prefix}-name-error`} required />
      <p class="field-error" id={`${prefix}-name-error`} hidden></p>
    </div>
    <div class="field-group">
      <label for={`${prefix}-email`}>Email address</label>
      <input id={`${prefix}-email`} name="email" type="email" inputmode="email" autocomplete="email" aria-describedby={`${prefix}-email-error`} required />
      <p class="field-error" id={`${prefix}-email-error`} hidden></p>
    </div>
  </div>
  <div class="field-group">
    <label for={`${prefix}-topic`}>{isJoin ? "Participation interest" : "Inquiry category"}</label>
    <select id={`${prefix}-topic`} name="topic" aria-describedby={`${prefix}-topic-error`} required>
      <option value="">Select one</option>
      {isJoin ? (
        <>
          <option>Attend a meeting</option><option>Join a committee</option><option>Request a presentation</option><option>Volunteer</option><option>Community partnership</option><option>Email updates</option>
        </>
      ) : (
        <>
          <option>General inquiry</option><option>Scholarship question</option><option>Event question</option><option>Media or presentation request</option><option>Support question</option>
        </>
      )}
    </select>
    <p class="field-error" id={`${prefix}-topic-error`} hidden></p>
  </div>
  <div class="field-group">
    <label for={`${prefix}-message`}>Message</label>
    <textarea id={`${prefix}-message`} name="message" rows="6" aria-describedby={`${prefix}-message-help ${prefix}-message-error`} required></textarea>
    <p class="field-help" id={`${prefix}-message-help`}>Do not enter sensitive or private information in this prototype.</p>
    <p class="field-error" id={`${prefix}-message-error`} hidden></p>
  </div>
  <button class="button button-primary" type="submit">Test {isJoin ? "interest" : "inquiry"} state</button>
  <p class="form-status" role="status" data-form-status></p>
</form>

<script>
  document.querySelectorAll<HTMLFormElement>("[data-prototype-form]").forEach((form) => {
    form.addEventListener("submit", (event) => {
      event.preventDefault();
      let firstInvalid: HTMLElement | undefined;
      form.querySelectorAll<HTMLInputElement | HTMLSelectElement | HTMLTextAreaElement>("input, select, textarea").forEach((field) => {
        const error = form.querySelector<HTMLElement>(`#${field.id}-error`);
        const invalid = !field.validity.valid;
        field.setAttribute("aria-invalid", String(invalid));
        if (error) {
          error.hidden = !invalid;
          error.textContent = invalid ? `Complete the ${field.labels?.[0]?.textContent?.toLowerCase() ?? "required"} field.` : "";
        }
        if (invalid && !firstInvalid) firstInvalid = field;
      });
      const status = form.querySelector<HTMLElement>("[data-form-status]");
      if (status) status.textContent = firstInvalid ? "Review the required fields above." : "Prototype success state: no information was sent or stored.";
      firstInvalid?.focus();
    });
  });
</script>
