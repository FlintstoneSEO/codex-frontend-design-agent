---
interface Props {
  title?: string;
  observed?: string;
}
const { title = "Current-site record", observed = "August 7, 2026" } = Astro.props;
---

<aside class="source-notice" aria-label="Content review status">
  <strong>{title}</strong>
  <p>Observed on {observed} and reconciled against the current published site. Any remaining contradiction or approval need is labelled where it appears.</p>
</aside>
