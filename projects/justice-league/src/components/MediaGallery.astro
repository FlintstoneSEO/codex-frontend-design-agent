---
import { galleryPhotos, galleryVideos } from "@/data/media";
---

<section class="media-gallery" aria-labelledby="media-videos-heading">
  <div class="section-heading-row"><p class="section-kicker">Video gallery</p><h2 id="media-videos-heading">Stories from the Justice League in the community.</h2></div>
  <div class="media-video-grid">
    {galleryVideos.map((video) => <article class="media-video-card">{video.kind === "youtube" && video.id ? <div class="video-shell" data-video-shell data-video-id={video.id}><img src={`https://i.ytimg.com/vi/${video.id}/hqdefault.jpg`} alt="" width="480" height="360" loading="lazy" decoding="async" /><button type="button" class="video-play" data-video-play aria-label={`Play ${video.title}`}><span aria-hidden="true">▶</span><span>Play video</span></button></div> : <img class="media-social-poster" src={video.poster} alt="" width="900" height="506" loading="lazy" decoding="async" />}<div><h3>{video.title}</h3><p>{video.description}</p>{video.id ? <a class="text-action" href={`https://www.youtube.com/watch?v=${video.id}`} target="_blank" rel="noreferrer">Watch on YouTube <span class="visually-hidden">(opens in a new tab)</span></a> : <span class="media-record-label">Social media record</span>}</div></article>)}
  </div>
</section>
<section class="media-gallery media-gallery--photos" aria-labelledby="media-photos-heading">
  <div class="section-heading-row"><p class="section-kicker">Photo gallery</p><h2 id="media-photos-heading">Moments from the work.</h2></div>
  <div class="photo-grid">{galleryPhotos.map((photo) => <figure><button type="button" class="photo-expand" data-photo-dialog={photo.id} aria-label={`Enlarge ${photo.title}`}><img src={photo.src} alt={photo.alt} width={photo.width} height={photo.height} loading="lazy" decoding="async" /></button><figcaption><strong>{photo.title}</strong>{photo.year && <span>{photo.year}</span>}</figcaption><dialog id={photo.id} aria-label={photo.title}><button type="button" class="dialog-close" data-dialog-close>Close</button><img src={photo.src} alt={photo.alt} width={photo.width} height={photo.height} /><p>{photo.title}{photo.year && ` (${photo.year})`}</p></dialog></figure>)}</div>
</section>

<script>
  document.querySelectorAll<HTMLElement>("[data-video-shell]").forEach((shell) => {
    shell.querySelector<HTMLButtonElement>("[data-video-play]")?.addEventListener("click", () => {
      const videoId = shell.dataset.videoId;
      if (!videoId) return;
      const iframe = document.createElement("iframe");
      iframe.src = `https://www.youtube-nocookie.com/embed/${videoId}?autoplay=1&rel=0`;
      iframe.title = shell.closest("article")?.querySelector("h3")?.textContent || "Justice League GLM video";
      iframe.allow = "accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share";
      iframe.allowFullscreen = true;
      iframe.referrerPolicy = "strict-origin-when-cross-origin";
      shell.replaceChildren(iframe);
      iframe.focus();
    });
  });
  document.querySelectorAll<HTMLButtonElement>("[data-photo-dialog]").forEach((button) => button.addEventListener("click", () => document.getElementById(button.dataset.photoDialog || "") instanceof HTMLDialogElement && (document.getElementById(button.dataset.photoDialog || "") as HTMLDialogElement).showModal()));
  document.querySelectorAll<HTMLButtonElement>("[data-dialog-close]").forEach((button) => button.addEventListener("click", () => button.closest("dialog")?.close()));
</script>
